toastr.options = {
    closeButton: true,
    debug: false,
    newestOnTop: false,
    progressBar: true,
    positionClass: "toast-bottom-right",
    preventDuplicates: false,
    onclick: null,
    showDuration: 300,
    hideDuration: 1000,
    timeOut: 5000,
    extendedTimeOut: 1000,
    showEasing: "swing",
    hideEasing: "linear",
    showMethod: "fadeIn",
    hideMethod: "fadeOut"
};

document.body.addEventListener("showToast", function (e) {
    const { type, message } = e.detail;
    toastr[type](message);
});


function lockSubmitButton(button) {
    if (button.dataset.locked === 'true') {
        return false; // bloqueia novos submits
    }

    button.dataset.locked = 'true';

    // efeito visual de desativado (sem disabled)
    button.style.pointerEvents = 'none';
    button.style.opacity = '0.7';

    button.dataset.originalText = button.innerHTML;

    button.innerHTML = `
        <span class="spinner-border spinner-border-sm me-2"
              role="status"
              aria-hidden="true"></span>
        Salvando...
    `;

    return true;
}


document.addEventListener('submit', function (e) {
    const form = e.target;
    const button = form.querySelector('.js-submit-btn');
    if (!button) return;

    const ok = lockSubmitButton(button);
    if (!ok) {
        e.preventDefault();
    }
});


function carregarAdicaoCredenciamentoIntegrante(Id) {
    const $modal = $('#credenciarIntegrante');
    const $body = $('#credenciarIntegranteBody');

    // Abre modal só com spinner
    $body.html(`
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    `);

    $modal.modal('show');

    // Quando o modal terminar de abrir
    $modal.one('shown.bs.modal', async function () {

        try {
            const response = await fetch(`/credenciamentos/${Id}/integrantes/add/`);

            if (!response.ok) {
                throw new Error('Erro ao carregar formulário');
            }

            const html = await response.text();

            // cria container temporário invisível
            const tempDiv = $('<div>').html(html);

            // injeta no DOM mas invisível
            $body.css('visibility', 'hidden').html(tempDiv);

            const $select = $body.find('#entidades');

            if ($select.length) {

                $select.select2({
                    dropdownParent: $body,
                    width: '100%',
                    allowClear: true,
                    closeOnSelect: false
                });
            }

            // Controle de perfil (radio buttons)
            const $formAvaliador = $body.find('#formAvaliador');
            const $formValidador = $body.find('#formValidador');

            function toggleForms() {

                // pega o radio selecionado dentro do modal
                const valor = $body.find('input[name="perfil"]:checked').val();

                // esconde todos
                $formAvaliador.addClass('d-none');
                $formValidador.addClass('d-none');

                // regra
                if (valor === "avaliador") {
                    $formAvaliador.removeClass('d-none');
                } else if (valor === "validador" || valor === "coordenador") {
                    $formValidador.removeClass('d-none');
                }
            }

            // Escuta mudança nos radios
            $body.on('change', 'input[name="perfil"]', function () {
                toggleForms();
            });

            // Mostra conteúdo já pronto
            $body.css('visibility', 'visible');

        } catch (error) {
            console.error(error);
            $body.html(`
                <div class="text-danger text-center py-4">
                    Erro ao carregar formulário.
                </div>
            `);
        }
    });
}


function carregarIntegrante(Id) {
    const body = document.getElementById('modalIntegranteBody');

    body.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    `;

    fetch(`/credenciamentos/${Id}/integrantes/`)
        .then(res => res.text())
        .then(html => {
            body.innerHTML = html;
        });
}


function carregarEdicaoIntegrante(Id, avaliacao_id) {
    const body = document.getElementById('modalIntegranteBody');

    body.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    `;

    fetch(`/credenciamentos/${Id}/integrantes/edit/`)
            .then(res => res.text())
            .then(html => {
                body.innerHTML = html;

                const $select = $('#modalIntegranteBody').find('#entidades');
                const entidadeFiscalId = $select.data('entidade-fiscal-id');

                if ($select.length) {
                    $select.select2({
                        dropdownParent: body,
                        width: '100%',
                        allowClear: true,
                        closeOnSelect: false,
                        placeholder: "Todas as entidades",
                        minimumInputLength: 3,
                        language: "pt-BR",
                        ajax: {
                            url: `/conta-atricon/ajax/${avaliacao_id}/entidades-avaliadas/`,
                            dataType: 'json',
                            delay: 250,
                            data: function (params) {
                                return {
                                    q: params.term,
                                    entidade_fiscal_id: entidadeFiscalId || undefined
                                };
                            },
                            processResults: function (data) {
                                return data;
                            },
                            cache: true
                        }
                    });
                }

                const $select_perfis = $('#modalIntegranteBody').find('#perfis');

                if ($select_perfis.length) {

                    $select_perfis.select2({
                        dropdownParent: body,
                        width: '100%',
                        allowClear: true,
                        closeOnSelect: false,
                        placeholder: "Todas os perfis",
                    });
                }
            });
    }


function carregarEvidencias(respostaId, tipo) {
    const body = document.getElementById(`modalEvidenciasBody${respostaId}`);

    body.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    `;

    fetch(`/questionarios/${respostaId}/evidencias/${tipo}/`)
        .then(res => res.text())
        .then(html => {
            body.innerHTML = html;
            
            htmx.process(body);

            initSummernote(body);
        });
}

document.addEventListener("click", function (e) {

    if (e.target.id === "limpar-selecao") {

        selecionadosGlobais.clear();

        document.querySelectorAll(".questionarios-checkbox")
            .forEach(cb => cb.checked = false);

        const checkAll = document.getElementById("check-all");
        if (checkAll) checkAll.checked = false;

        atualizarBarraAcoes();
    }
});

document.addEventListener("change", function(e){

    if(e.target.id === "check-all"){

        const wrapper = document.getElementById("questionarios-wrapper");

        wrapper.querySelectorAll(".questionarios-checkbox")
        .forEach(cb => {
            cb.checked = e.target.checked;
        });

    }
});


document.addEventListener("click", function(e){

    const btn = e.target.closest(".filtro-btn");
    if(!btn) return;

    // Detecta se é clique que realmente muda filtro
    const isFiltroClick =
        btn.classList.contains("dropdown-item") || 
        btn.classList.contains("filtro-todas") ||
        !btn.classList.contains("filtro-dropdown");

    // Limpa seleção ao trocar filtro
    if (isFiltroClick) {
        selecionadosGlobais.clear();

        document.querySelectorAll(".questionarios-checkbox")
            .forEach(cb => cb.checked = false);

        atualizarBarraAcoes();
    }

    // Reset geral de estilos
    document.querySelectorAll(".filtro-btn, .filtro-dropdown").forEach(el => {
        el.classList.remove("btn-primary","active");
        el.classList.add("btn-outline-secondary");
    });

    // Se clicou em "Todas"
    if(btn.classList.contains("filtro-todas")){

        // Ativa o botão
        btn.classList.remove("btn-outline-secondary");
        btn.classList.add("btn-primary","active");

        // Resetar dropdowns (texto original)
        document.querySelectorAll(".filtro-dropdown").forEach(drop => {
            drop.innerHTML = drop.dataset.default;
        });

        return;
    }

    // Se veio do dropdown
    if(btn.classList.contains("dropdown-item")){

        const dropdown = btn.closest(".btn-group");
        const toggle = dropdown.querySelector(".filtro-dropdown");

        toggle.classList.remove("btn-outline-secondary");
        toggle.classList.add("btn-primary","active");

        toggle.innerHTML = btn.innerText;

    } else {
        // Botão normal
        btn.classList.remove("btn-outline-secondary");
        btn.classList.add("btn-primary","active");
    }
});


let selecionadosGlobais = new Set();

function atualizarBarraAcoes(){

    const barra = document.getElementById("acoes-lote")
    const contador = document.getElementById("contador-selecionados")

    if(!barra || !contador) return

    contador.innerText = selecionadosGlobais.size

    barra.classList.toggle("d-none", selecionadosGlobais.size === 0)
}

document.addEventListener("change", function(e){

    // checkbox individual
    if(e.target.matches(".questionarios-checkbox")){

        const id = e.target.value;

        if(e.target.checked){
            selecionadosGlobais.add(id);
        } else {
            selecionadosGlobais.delete(id);
        }

        atualizarBarraAcoes()
    }

    // check-all (da página)
    if(e.target.matches("#check-all")){

        const checked = e.target.checked;

        document.querySelectorAll(".questionarios-checkbox")
        .forEach(cb => {

            cb.checked = checked;

            if(checked){
                selecionadosGlobais.add(cb.value);
            } else {
                selecionadosGlobais.delete(cb.value);
            }
        });

        atualizarBarraAcoes()
    }
});

document.body.addEventListener("htmx:afterSettle", function(evt){

    if(evt.target.id === "questionarios-wrapper"){

        document.querySelectorAll(".questionarios-checkbox")
        .forEach(cb => {
            cb.checked = selecionadosGlobais.has(cb.value);
        });

        atualizarBarraAcoes()
    }
})


function carregarAtribuirValidador(avaliacaoId) {
    const body = document.getElementById('modalAtribuirValidadorBody');

    body.innerHTML = `
        <div class="text-center py-5">
            <div class="spinner-border"></div>
        </div>
    `;

    fetch(`/dashboard/pntp/${avaliacaoId}/validadores/`)
        .then(res => res.text())
        .then(html => {
            body.innerHTML = html;

            const select = $('#modalAtribuirValidadorBody').find('#integrantes');

            if (select.length) {

                select.select2({
                    dropdownParent: body,
                    width: '100%',
                });
            }
        });
}


function carregarTramitacoes(questionarioId) {
    const body = document.getElementById(`modalTramitacaoBody`);

    body.innerHTML = `<div class="text-center py-5">
        <div class="spinner-border"></div>
    </div>`;

    fetch(`/questionarios/${questionarioId}/tramitacoes/`)
        .then(res => res.text())
        .then(html => {
            body.innerHTML = html;

            // SETOR
            $("#setor_id").off("change").on("change", function () {

                var url = $("#tramitacaoForm").attr("data-motivos-url");
                var setorId = $(this).val();

                $.ajax({
                    url: url,
                    data: { 
                        setor: setorId,
                        questionario: questionarioId
                    },
                    success: function (data) {
                        $("#motivo_id").html(data);
                        $("#motivo_id").trigger("change");
                    }
                });
            });

            // MOTIVO
            $("#motivo_id").off("change").on("change", function () {

                const valor = $(this).val();
                const inputDataFinal = $("#id_data_final");

                if (valor === "EM") {
                    $("#data-final-container").removeClass("d-none");
                    inputDataFinal.prop("required", true);

                    setTimeout(() => {
                        inputDataFinal.trigger("focus");
                    }, 100);
                } else {
                    $("#data-final-container").addClass("d-none");
                    inputDataFinal.prop("required", false);
                    inputDataFinal.val("");
                }
            });
        });
}


